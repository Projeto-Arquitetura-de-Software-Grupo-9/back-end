# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_correge_development_2026
JWT_EXPIRES_IN=7d

# Database Connection (SQLite by default for zero-setup local dev, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/correge_db?schema=public"

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
