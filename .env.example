# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api

# Database Connection (MySQL / TiDB Cloud Serverless via Prisma ORM)
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=sgp_catolica
CA_PATH=./prisma/isrgrootx1.pem
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/sgp_catolica?sslaccept=strict"

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=replace_with_a_strong_random_secret_in_production
JWT_EXPIRES_IN=7d

# Optional Institutional SMTP for Password Reset
# SMTP_HOST=smtp.catolicasc.org.br
# SMTP_PORT=587
# SMTP_USER=noreply@catolicasc.org.br
# SMTP_PASS=YOUR_SMTP_PASSWORD

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
