# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api

# Data Source Strategy: 'mock' (in-memory test data) or 'database' (MySQL via Prisma)
DATA_SOURCE=mock

# Database Connection (MySQL / MariaDB para sgp_catolica)
DATABASE_URL="mysql://root:password@localhost:3306/sgp_catolica"

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_correge_development_2026
JWT_EXPIRES_IN=7d

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
